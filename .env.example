DATABASE_URL=postgresql://app:app@localhost:5432/ops_inbox?schema=public
PORT=3000
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me
# mock = record OutboundCall without network (default for demos; preferred locally)
# http = POST to OUTBOUND_URL (sends title/summary — do not point at prod customer systems)
OUTBOUND_MODE=mock
OUTBOUND_URL=https://httpbin.org/post
OUTBOUND_TIMEOUT_MS=5000
